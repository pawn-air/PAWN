+vector<Eigen::Vector3f> System::GetAllMapPointPositions()
+{
+    vector<Eigen::Vector3f> positions;
+
+    Map* currentMap = mpAtlas->GetCurrentMap();
+
+    if (currentMap == nullptr)
+        return positions;
+
+    // Synchronize with map updates.
+    unique_lock<mutex> lock(currentMap->mMutexMapUpdate);
+
+    vector<MapPoint*> points = currentMap->GetAllMapPoints();
+
+    positions.reserve(points.size());
+
+    for (MapPoint* point : points)
+    {
+        if (point == nullptr || point->isBad())
+            continue;
+
+        Eigen::Vector3f position = point->GetWorldPos();
+
+        if (position.allFinite())
+            positions.push_back(position);
+    }
+
+    return positions;
+}
